# The sensitive paths (branching-and-review.md). A change to any of them
# requests a review from the team. Until the line rulesets require code
# owner review, this file only requests the review.
/src/java/org/apache/cassandra/auth/                  @chronitonlabs/sensitive-reviewers
/src/java/org/apache/cassandra/transport/             @chronitonlabs/sensitive-reviewers
/src/java/org/apache/cassandra/net/                   @chronitonlabs/sensitive-reviewers
/src/java/org/apache/cassandra/security/              @chronitonlabs/sensitive-reviewers
/src/java/org/apache/cassandra/service/ClientState.java @chronitonlabs/sensitive-reviewers
/src/java/org/chronitondb/**/auth/                    @chronitonlabs/sensitive-reviewers
/src/java/org/chronitondb/**/net/                     @chronitonlabs/sensitive-reviewers
/build.xml                                            @chronitonlabs/sensitive-reviewers
/.build/                                              @chronitonlabs/sensitive-reviewers
/lib/                                                 @chronitonlabs/sensitive-reviewers
/conf/                                                @chronitonlabs/sensitive-reviewers
/bin/                                                 @chronitonlabs/sensitive-reviewers
/debian/                                              @chronitonlabs/sensitive-reviewers
/redhat/                                              @chronitonlabs/sensitive-reviewers

# The process and governance are the maintainers' decision (governance.md),
# so changes there request a maintainer's review.
/docs/process/                                        @chronitonlabs/maintainers
/docs/governance/                                     @chronitonlabs/maintainers

# The checks of a pull request run from these two folders, and a pull
# request runs the workflow files it brings. So the maintainers own them,
# and a change there merges only with a maintainer's approving review once
# the line rulesets require code owner review. /.github/ covers this file
# too. GitHub ignores an owner without write access to the repository, and
# a path whose only owner is ignored needs no review, so the team named
# here keeps write access.
/tools/chronitondb/                                   @chronitonlabs/maintainers
/.github/                                             @chronitonlabs/maintainers
